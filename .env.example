# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# 서버
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# HTTPS 뒤에서 운영할 때 1로 설정 (로그인 쿠키에 Secure 속성 추가)
COOKIE_SECURE=0
# 브라우저로 이 앱에 접속하는 주소. 구글 연동의 리디렉션 주소 기준이 되며, 실제 접속 주소와 같아야 합니다.
PUBLIC_URL=http://localhost:3000

# 최초 관리자 계정 (등록된 사용자가 하나도 없을 때 서버 시작 시 한 번만 생성됨)
# ADMIN_PASSWORD 를 비워 두면 "아이디 = 첫 비밀번호" 로 만들어지고, 로그인 후 비밀번호 변경 창이 뜹니다.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 구글 계정 연동 (화면 상단 "구글 시트 연동"에서 연동 신청)
# Google Cloud Console 에서 만든 OAuth 클라이언트(웹 애플리케이션)의 값.
# 승인된 리디렉션 URI: ${PUBLIC_URL}/api/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 시트 기본값 (비워 두고 화면의 "구글 시트 연동"에서 시트 주소를 저장해도 됩니다)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=캐릭터 컨셉 로드맵

# (선택) 계정 연동 대신 서비스 계정 키를 쓰는 방식. 연동된 구글 계정이 있으면 그쪽이 우선입니다.
# 서비스 계정 키(JSON) 파일 경로. 파일 내용을 직접 넣으려면 GOOGLE_SERVICE_ACCOUNT_JSON 사용
GOOGLE_SERVICE_ACCOUNT_FILE=
SYNC_INTERVAL_SEC=30
