# 서버
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# HTTPS 뒤에서 운영할 때 1로 설정 (로그인 쿠키에 Secure 속성 추가)
COOKIE_SECURE=0

# 최초 관리자 계정 (등록된 사용자가 하나도 없을 때 서버 시작 시 한 번만 생성됨)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 구글 시트 연동 (모두 설정해야 동기화 ON/OFF 버튼이 활성화됨)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=캐릭터 컨셉 로드맵
# 서비스 계정 키(JSON) 파일 경로. 파일 내용을 직접 넣으려면 GOOGLE_SERVICE_ACCOUNT_JSON 사용
GOOGLE_SERVICE_ACCOUNT_FILE=
SYNC_INTERVAL_SEC=30
